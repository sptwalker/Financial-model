# ===== 创想悦动现金流预测系统 — Docker Compose 部署环境变量模板 =====
# 用法：cp .env.example .env  然后填入真实值
# .env 已被 .gitignore 排除，绝不提交真实凭据。
# 后端本地开发（不用 Docker）请改用 backend/.env.example。

# --- 必填：数据库密码与 JWT 密钥 ---
POSTGRES_PASSWORD=please-set-a-strong-db-password
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生产（DEBUG=false）下若仍为 dev 默认值，后端会拒绝启动。
SECRET_KEY=please-generate-a-random-secret-key

# --- 必填：对外访问地址（飞书回调与前端跳转都依赖它）---
# 必须与飞书开放平台「安全设置 → 重定向 URL」完全一致。
FEISHU_REDIRECT_URI=https://fm.example.com/api/v1/auth/feishu/callback
FRONTEND_URL=https://fm.example.com

# --- 必填：飞书自建应用凭据（在飞书开放平台创建后填写）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- 可选：nginx 对外端口（宿主机侧）---
# 默认 8021；服务器 80 端口空闲时可改为 80
WEB_PORT=8021

# --- 可选：构建期 pip 源（国内服务器默认走华为云镜像）---
# 境外构建改回官方源：https://pypi.org/simple
PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
PIP_TRUSTED_HOST=repo.huaweicloud.com

# --- 可选：初始角色名单（JSON 数组，元素为飞书 open_id）---
# 名单内用户首次登录直接 active 并授予对应角色，不走「待审批」；
# 已登录过的用户由后端启动时自动补升（幂等）。其余新用户首登为 pending，
# 需管理员在「管理」菜单放行后方可进入。
INITIAL_ADMIN_FEISHU_IDS=[]
INITIAL_EDITOR_FEISHU_IDS=[]
