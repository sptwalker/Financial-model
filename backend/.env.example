# ===== 创想悦动现金流预测系统 — 本地开发环境变量模板 =====
# 复制为 backend/.env 并填入真实值；.env 已被 .gitignore 排除，绝不提交真实凭据。
# 本地开发保持 DEBUG=true 即可用 dev-login 一键进管理员，无需飞书凭据。
# Docker 部署用的是**仓库根** .env —— 见根目录 .env.example。

# --- 安全（生产必改）---
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-random-secret-key

# --- 运行模式 ---
DEBUG=false
ENABLE_DEV_LOGIN=false

# --- 数据库（Docker 内 api 容器使用；本地开发保持默认 sqlite 即可）---
DATABASE_URL=postgresql+psycopg2://fmuser:fm_password@postgres:5432/financial_model

# --- 飞书自建应用（在飞书开放平台创建后填写）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与飞书开放平台「安全设置 → 重定向 URL」完全一致
FEISHU_REDIRECT_URI=https://fm.example.com/api/v1/auth/feishu/callback

# --- 前端地址（飞书回调重定向目标）---
FRONTEND_URL=https://fm.example.com

# --- CORS（JSON 数组；与 FRONTEND_URL 同源时可不加）---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- 初始角色名单（JSON 数组，元素为飞书 open_id）---
# 名单内用户首次登录直接 active 并授予对应角色，不走「待审批」；
# 已登录过的用户由后端启动时自动补升（幂等）。其余新用户首登为 pending，
# 需管理员在「管理」菜单放行后方可进入。
# 刘丹（默认管理员）：把其飞书 open_id 填入下方数组，例如 ["ou_xxxxxxxx"]
INITIAL_ADMIN_FEISHU_IDS=[]
INITIAL_EDITOR_FEISHU_IDS=[]
