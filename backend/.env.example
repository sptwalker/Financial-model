# ===== 创想悦动现金流预测系统 — 环境变量模板 =====
# 复制为 backend/.env 并填入真实值；.env 已被 .gitignore 排除，绝不提交真实凭据。
# Docker 部署时另需仓库根 .env（见 docker-compose.yml 顶部注释）。

# --- 安全（生产必改）---
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-random-secret-key

# --- 运行模式 ---
DEBUG=false
ENABLE_DEV_LOGIN=false

# --- 数据库（Docker 内 api 容器使用；本地开发保持默认 sqlite 即可）---
DATABASE_URL=postgresql+psycopg2://fmuser:fm_password@postgres:5432/financial_model

# --- 飞书自建应用（在飞书开放平台创建后填写）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与飞书开放平台「安全设置 → 重定向 URL」完全一致
FEISHU_REDIRECT_URI=http://172.28.252.38/api/v1/auth/feishu/callback

# --- 前端地址（飞书回调重定向目标；内测为局域网 nginx 地址）---
FRONTEND_URL=http://172.28.252.38

# --- CORS（JSON 数组；与 FRONTEND_URL 同源时可不加）---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
